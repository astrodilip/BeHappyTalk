{
  "expo": {
    "name": "behappytalk",
    "slug": "behappytalk",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "behappytalk",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bitcode": false
    },
    "android": {
      "versionCode": 12,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "package": "com.behappytalk.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "ndkVersion": "27.0.12077973",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# react-native-incall-manager ships no consumer rules and is reached over the RN bridge.\n-keep class com.zxcpoiu.incallmanager.** { *; }\n# Keep RN/Expo native module entry points that are resolved reflectively.\n-keep @com.facebook.react.module.annotations.ReactModule class * { *; }\n-keepclassmembers class * { @com.facebook.react.bridge.ReactMethod *; }"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs photo library access to allow you to send images in chat."
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/withUnrestrictedScannerOrientation",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c12e6875-a116-49a3-84a9-7c5510e47326"
      }
    },
    "owner": "anshsharma825"
  }
}
